#community-users.community-settings
  header
    soci-link(href=`/@community/admin` class="nav-item") <span>Settings</span>
    soci-link(href=`/@community/admin/users` class="nav-item active") <span>Users</span>
    soci-link(href=`/@community/admin/financials` class="nav-item") <span>Financials</span>
    soci-link(href=`/@community/admin/emojis` class="nav-item") <span>Emojis</span>
  .container
    .load-group(load-order="primary")
      h1 Community Users
      p Manage moderators, members, and bans in one place.
    .load-group(load-order="secondary")
      .grid
        .card
          .card-header(data-role="moderators")
            h2 Moderators
            soci-button.add-btn(subtle data-role="moderators" aria-label="Add moderator")
              soci-icon(glyph="create")
              span add
            soci-user-picker(data-role="moderators" placeholder="Add moderator" action-label="Add")
          .list(data-list="moderators")
        .card
          .card-header(data-role="members")
            h2 Members
            soci-button.add-btn(subtle data-role="members" aria-label="Add member")
              soci-icon(glyph="create")
              span add
            soci-user-picker(data-role="members" placeholder="Add member" action-label="Add")
          .list(data-list="members")
        .card
          .card-header(data-role="banned")
            h2 Banned Users
            soci-button.add-btn(subtle data-role="banned" aria-label="Ban user")
              soci-icon(glyph="create")
              span add
            soci-user-picker(data-role="banned" placeholder="Ban user" action-label="Ban")
          .list(data-list="banned")

script.
  lazyload('/pages/community-users.js', document.currentScript.closest('soci-route'))
