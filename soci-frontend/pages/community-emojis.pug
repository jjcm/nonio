#community-emojis.community-settings
  header
    nonio-link(href=`/@community/admin` class="nav-item") <span>Settings</span>
    nonio-link(href=`/@community/admin/users` class="nav-item") <span>Users</span>
    nonio-link(href=`/@community/admin/financials` class="nav-item") <span>Financials</span>
    nonio-link(href=`/@community/admin/emojis` class="nav-item active") <span>Emojis</span>
  .container
    h1 Community Emojis
    form#emoji-form
      input#emoji-name(type="text" placeholder="emoji_name" required pattern="^[a-z0-9_]{2,32}$")
      input#emoji-file(type="file" accept="image/*" required)
      nonio-button#emoji-upload(async) Upload
    .emoji-grid#emoji-grid

script.
  lazyload('/pages/community-emojis.js', document.currentScript.closest('nonio-route'))
