style.
  #admin-emojis {
    .container { max-width: 900px; margin: 0 auto; padding: 20px; }
    form { display: flex; gap: 8px; align-items: center; margin-bottom: 16px; flex-wrap: wrap; }
    input[type="text"] { min-width: 180px; }
    .emoji-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(90px, 1fr)); gap: 10px; }
    .emoji-card { border: 1px solid var(--bg-secondary); border-radius: 8px; padding: 8px; text-align: center; }
    .emoji-card img, .emoji-card soci-emoji { width: 24px; height: 24px; display: block; margin: 0 auto 6px; }
    .emoji-name { font-size: 12px; color: var(--text-secondary); }
  }
#admin-emojis.container
  h1 Personal Emojis
  form#emoji-form
    input#emoji-name(type="text" placeholder="emoji_name" required pattern="^[a-z0-9_]{2,32}$")
    input#emoji-file(type="file" accept="image/*" required)
    soci-button#emoji-upload(async) Upload
  .emoji-grid#emoji-grid

script.
  lazyload('/pages/admin/emojis.js', document.currentScript.closest('soci-route'))
