#community-settings.community-settings
  header
    soci-link(href=`/@community/admin` class="nav-item active") <span>Settings</span>
    soci-link(href=`/@community/admin/users` class="nav-item") <span>Users</span>
    soci-link(href=`/@community/admin/financials` class="nav-item") <span>Financials</span>
    soci-link(href=`/@community/admin/emojis` class="nav-item") <span>Emojis</span>
  .container
    form
      .load-group(load-order="primary")
        h1 Community Settings
        label Banner
        soci-avatar-uploader(type="banner")
      
      .load-group(load-order="secondary")
        .columns
          .column.basic-info
            h2 Basic Info
            label(for="name") Display name
            input(name="name" placeholder="Community Name" required)
            label(for="description") Description
            soci-input(name="description" placeholder="Add a short description of your community")
            div(style="margin-top: 8px; text-align: right;")
              soci-button Save Changes
          .column
            h2 Privacy & Permissions
            label Privacy
            soci-radio-button-group(name="privacy" class="radio-group" value="public")
              soci-radio-button(value="public") Public
              soci-radio-button(value="invite-only") Invite Only

            label Who can post?
            soci-radio-button-group(name="post_permission" class="radio-group" value="all")
              soci-radio-button(value="all") All Users
              soci-radio-button(value="paid") Paid Users Only
              soci-radio-button(value="admin") Admins Only
            
            label Who can comment?
            soci-radio-button-group(name="comment_permission" class="radio-group" value="all")
              soci-radio-button(value="all") All Users
              soci-radio-button(value="paid") Paid Users Only
              soci-radio-button(value="admin") Admins Only
      

script.
  lazyload('/pages/community-settings.js', document.currentScript.closest('soci-route'))
