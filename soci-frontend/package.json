  },
  "homepage": "https://github.com/jjcm/soci-components#readme",
  "dependencies": {
    "mime-types": "^2.1.24",
    "prerender-node": "^3.2.5",
    "pug": "^3.0.1"
  },
  "devDependencies": {
    "pug-cli": "^1.0.0-alpha6",
    "puppeteer-core": "^25.8.0"
  }
