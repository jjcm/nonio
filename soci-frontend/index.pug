doctype html
html(lang="en")
  title Nonio
  meta(http-equiv="content-type" content="text/html; charset=utf-8")
  meta(name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1")
  link(rel="icon" type="image/svg+xml" href="/lib/favicon.svg")
  //- The stylesheet comes before any synchronous script: markdown.js used to
  //- block the parser here, delaying CSS discovery and first paint.
  link(rel="stylesheet" href="/nonio.css")
  //- Start the feed API request in parallel with the JS module graph: by the
  //- time nonio-post-list connects, the response is usually already in flight
  //- or done (window.__preFetch, consumed by nonio-post-list._loadPosts).
  //- Mirrors _buildPostsUrl exactly (param order matters) for the anonymous
  //- home/tag/user cold loads; anything else falls through to a normal fetch.
  script.
    // Column prefs were stored under soci-* before the rename. This has to run
    // here, not in a module: the prefetch below reads them.
    ;['sort', 'filter', 'view'].forEach(k => {
      let v = localStorage.getItem('soci-column-' + k)
      if(v == null) return
      localStorage.removeItem('soci-column-' + k)
      if(localStorage.getItem('nonio-column-' + k) == null) localStorage.setItem('nonio-column-' + k, v)
    })
    ;(a => {
      if(localStorage.getItem('accessToken')) return
      let pf = window.__preFetch = {}
      let add = u => { let f = fetch(a + u).then(r => r.json()); f.catch(() => {}); pf[u] = f }
      let p = location.pathname, q = []
      let s = localStorage.getItem('nonio-column-sort')
      if(s == 'new') q.push('sort=new')
      else if(['day', 'week', 'month', 'year'].includes(s)) q.push('sort=top', 'time=' + s)
      let feed = tail => {
        let f = localStorage.getItem('nonio-column-filter')
        if(f && f != 'all') {
          let m = { images: 'image', videos: 'video', blogs: 'blog', links: 'link', audio: 'audio' }
          tail.push('type=' + encodeURIComponent(m[f] || f))
        }
        add('/posts' + (q.concat(tail).length ? '?' + q.concat(tail).join('&') : ''))
      }
      if(p == '/') {
        let t = decodeURIComponent(location.hash.slice(1).split('+')[0] || '')
        feed(t && t != 'all' ? ['tag=' + encodeURIComponent(t)] : [])
      }
      else if(p.startsWith('/user/') && p.length > 6 && location.hash != '#comments')
        feed(['user=' + encodeURIComponent(p.slice(6))])
      else {
        let m = p.match(/^\/(?:@([\w-]+)\/)?([\w-]+)$/)
        if(m && !['about', 'submit', 'notifications'].includes(m[2])) {
          add(m[1] ? `/posts/@${m[1]}/${m[2]}` : `/posts/${m[2]}`)
          add(`/comments?post=${m[2]}` + (m[1] ? `&community=${m[1]}` : ''))
        }
      }
    })('#{apiHost || ""}')
  //- defer: this classic script still executes before the module scripts
  //- (document order), so window.markdown exists before any component code
  //- runs, but it no longer blocks the parser while it downloads.
  script(src="/lib/markdown-wasm/markdown.js" defer)
  script(src="/nonio.js" type="module")
  script(src="/components/nonio-components.js" type="module")
  script.
    let lazyload = (path, parent) => {
      document.addEventListener('DOMContentLoaded', ()=>{
        let resource = document.createElement('script')
        resource.async = 'true'
        resource.src = path
        let root = parent ? parent : document.head
        root.appendChild(resource)
      })
    }

  include sidebar.pug
  #pages
    nonio-route#text-channel(path="^/@[\\w-]+:[^/#?]+$" fresh)
      script.
        lazyload('/pages/text-channel.js', document.currentScript.closest('nonio-route'))
    nonio-route#tags(test="both" path="^(/@[\\w-]+)?/?(#.*)?$" fresh)
      include pages/tags.pug
    nonio-route#admin-create(path="/admin/create-account").admin-page
      include pages/admin/create.pug
    nonio-route#admin-subscribe(path="/admin/subscribe" fresh).admin-page
      include pages/admin/subscribe.pug
    nonio-route#admin-forgot-password(path="/admin/forgot-password").admin-page
      include pages/admin/forgot-password.pug
    nonio-route#admin-change-forgotten-password(path="/admin/change-forgotten-password").admin-page
      include pages/admin/change-forgotten-password.pug
    nonio-route#admin-settings(path="/admin/settings").admin-page
      include pages/admin/settings.pug
    nonio-route#notifications(path="/notifications")
      include pages/notifications.pug
    nonio-route#user(test="both" path="^/user/" fresh)
      include pages/user.pug
    nonio-route#submit(path="^(/@[\\w-]+)?/submit$" fresh)
      include pages/submit.pug
    nonio-route#admin-financials(path="/admin/financials").admin-page
      include pages/admin/financials.pug
    nonio-route#admin-emojis(path="/admin/emojis").admin-page
      include pages/admin/emojis.pug
    nonio-route#about(path="/about")
      include pages/about/about.pug
    nonio-route#privacy-policy(path="/about/privacy-policy")
      include pages/about/privacy-policy.pug
    nonio-route#contact(path="/about/contact")
      include pages/about/contact.pug

    nonio-route#community-settings(path="^(/@[\\w-]+)/admin$" fresh)
      include pages/community-settings.pug
    nonio-route#community-users(path="^(/@[\\w-]+)/admin/users$" fresh)
      include pages/community-users.pug
    nonio-route#community-financials(path="^(/@[\\w-]+)/admin/financials$" fresh)
      include pages/community-financials.pug
    nonio-route#community-emojis(path="^(/@[\\w-]+)/admin/emojis$" fresh)
      include pages/community-emojis.pug

    nonio-route#post(default fresh)
      include pages/post.pug

  script(src="/pages/post.js")
