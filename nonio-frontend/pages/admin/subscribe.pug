.content
  style.
    #admin-subscribe {
      background: var(--bg-bold);
      height: 100%;
      overflow-y: auto;
    }

    #admin-subscribe[active] {
      display: block;
    }

    #admin-subscribe .columns {
      display: flex;
      margin: 40px -20px 0;
      width: calc(100% + 40px);
      align-items: flex-start;
    }

    #admin-subscribe .column {
      border: 1px solid var(--bg-secondary);
      border-radius: 4px;
      width: 100%;
      box-shadow: 0 2px 8px var(--shadow);
      background: var(--bg);
      position: relative;
      overflow: hidden;
      transition: height 0.2s var(--nonio-ease);
    }

    #admin-subscribe .column:first-child {
      margin-right: 10px;
    }

    #admin-subscribe .column.supporter[active] .features {
      opacity: 0;
      transition: all var(--anim-duration-med) var(--nonio-ease);
      pointer-events: none;
    }

    #admin-subscribe .column.supporter[active] .payment {
      opacity: 1;
      pointer-events: all;
      user-select: all;
      transform: translateY(0px);
    }

    #admin-subscribe h3 {
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: 1.4px;
      font-weight: normal;
      margin-top: 20px;
    }

    #admin-subscribe .features {
      opacity: 1;
    }

    #admin-subscribe .payment {
      box-sizing: border-box;
      overflow: hidden;
      position: absolute;
      transition: all var(--anim-duration-med) var(--nonio-ease) var(--anim-duration-short);
      padding: 10px 20px;
      opacity: 0;
      user-select: none;
      pointer-events: none;
      width: 100%;
      transform: translateY(10px);
    }

    #admin-subscribe #card-element {
      border-bottom: 2px solid var(--bg-secondary);
      height: 38px;
      margin-bottom: 10px;
    }

    #admin-subscribe .price-container {
      position: relative;
      padding: 0 20px 10px;
      border-bottom: 1px solid var(--bg-secondary);
    }

    #admin-subscribe .price-container nonio-button {
      position: absolute;
      bottom: 20px;
      right: 20px;
    }

    #admin-subscribe .title {
      padding: 10px 20px 0;
    }

    #admin-subscribe .title p {
      color: var(--text-secondary);
      height: 80px;
    }

    #admin-subscribe h2 {
      color: var(--text-bold);
      margin-bottom: 4px;
    }

    #admin-subscribe .price {
      font-size: 44px;
      font-weight: bold;
      color: var(--text-brand);
    }

    #admin-subscribe .price span {
      font-size: 14px;
      font-weight: normal;
      color: var(--text-secondary);
    }

    #admin-subscribe ul {
      list-style: none;
      padding: 0 20px;
    }

    #admin-subscribe li {
      position: relative;
      line-height: 24px;
      padding-left: 20px;
    }

    #admin-subscribe li.cant {
      color: var(--text-secondary);
      text-decoration: line-through;
    }

    #admin-subscribe li.cant:after,
    #admin-subscribe li.cant:before {
      content: '';
      display: block;
      position: absolute;
      width: 10px;
      height: 2px;
      left: 0;
      top: calc(50% - 1px);
      background: var(--text-danger);
    }

    #admin-subscribe li.cant:after {
      transform: rotate(45deg);
    }

    #admin-subscribe li.cant:before {
      transform: rotate(-45deg);
    }

    #admin-subscribe li.can:after,
    #admin-subscribe li.can:before {
      content: '';
      display: block;
      position: absolute;
      width: 2px;
      background: var(--text-success);
      height: 5px;
      top: calc(50% - 2px);
      left: 0;
      transform: rotate(-45deg);
    }

    #admin-subscribe li.can:after {
      height: 9px;
      top: calc(50% - 5px);
      left: 4px;
      transform: rotate(45deg);
    }

    #admin-subscribe form nonio-button {
      margin: 24px 0 8px;
    }

  script(src="/pages/admin/subscribe.js")
  .loading-block(load-order="primary")
    h1 Subscription
    p Please pick your account type:

  .columns(load-order="secondary")
    .column.supporter
      .title
        h2 Supporter
        p This allows you to contribute back to the creators. You choose your subscription price, and your subscription pool is divided evenly between everything you upvote that month.
      .payment
        form#payment-form(style="user-select: none;")
          h3 Contribution
          nonio-contribution-slider(name="subscriptionAmount")
          h3 Payment Info
          input(name="name" placeholder="Name")
          #card-element
          #card-element-errors(role="alert")
          nonio-button.subscribe-button(async onclick="adminSubscribe.subscribe()") Subscribe
      .features
        .price-container
          .price $2-10<span>/mo</span>
          nonio-button.supporter-button(async onclick="adminSubscribe.chooseSupporter()") Choose supporter
        ul
          li.can Submit posts
          li.can Upvote and fund posts
          li.can Browse and view posts
          li.can Comment on posts
          li.can Upvote and downvote comments
    .column 
      .title
        h2 Free
        p Everyone starts somewhere. Even if you don't contribute monetarily, you can still shower the creators with praise in the comments!
      .features
        .price-container
          .price $0<span>/mo</span>
          nonio-button.free-button(async subtle onclick="adminSubscribe.chooseFree()") Choose free
        ul
          li.cant Submit posts
          li.cant Upvote and fund posts
          li.can Browse and view posts
          li.can Comment on posts
          li.can Upvote and downvote comments
    