title Soci Backend API

include sidebar.pug

script.
  document.getElementById('llm-copy-btn').onclick = function() {
    fetch('/LLM.md').then(function(r) { return r.text(); }).then(function(t) {
      navigator.clipboard.writeText(t).then(function() {
        var btn = document.getElementById('llm-copy-btn');
        btn.textContent = 'Copied!';
        setTimeout(function() { btn.textContent = 'LLMs'; }, 1500);
      });
    });
  };

