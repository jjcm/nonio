#### update the values of environment variables

Environment=APP_PORT=4204               # the application port

#### start the application by systemd

$ cp nonio-video-cdn.service /etc/systemd/system/    # copy the 'nonio-video-cdn.service' to directory '/etc/systemd/system'
$ systemctl daemon-reload
$ systemctl enable nonio-video-cdn.service
$ systemctl start nonio-video-cdn.service
$ systemctl status nonio-video-cdn.service
$ systemctl stop nonio-video-cdn.service