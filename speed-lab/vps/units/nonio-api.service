[Unit]
Description=Nonio API (socid)
After=network.target mariadb.service
Wants=mariadb.service

[Service]
User=fable
WorkingDirectory=/home/fable/nonio/soci-backend
EnvironmentFile=/home/fable/env/api.env
ExecStart=/home/fable/nonio/soci-backend/dist/socid
Restart=always
RestartSec=2
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
