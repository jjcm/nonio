[Unit]
Description=Nonio frontend (node)
After=network.target

[Service]
User=fable
WorkingDirectory=/home/fable/nonio/soci-frontend
Environment=PORT=4200
Environment=NODE_ENV=production
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=2
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
