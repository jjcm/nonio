#### update the values of environment variables

Environment=APP_PORT=4202               # the application port

#### start the application by systemd

$ cp nonio-avatar-cdn.service /etc/systemd/system/    # copy the 'nonio-avatar-cdn.service' to directory '/etc/systemd/system'
$ systemctl daemon-reload
$ systemctl enable nonio-avatar-cdn.service
$ systemctl start nonio-avatar-cdn.service
$ systemctl status nonio-avatar-cdn.service
$ systemctl stop nonio-avatar-cdn.service